+fn cleanup_unused_locals(ops: &[Cell<Op<'_>>], jump_targets: &HashSet<usize>) {
+    // Removing a dead read can make an earlier local store dead only on the next pass.
+    let measure = || ops.iter().fold((0usize, 0usize), |(live, stores), op| {
+        let op = op.get();
+        (live + usize::from(!op.is_nop()), stores + usize::from(matches!(op, Op::SetLocal { .. } | Op::StoreLocal { .. })))
+    });
+    loop {
+        let before = measure();
+        dead_locals::eliminate_unused_locals(ops);
+        peephole::postprocess_peephole(ops, jump_targets, true);
+        let after = measure();
+        if after == before { break; }
+        assert!(after < before, "Dead-local cleanup must monotonically remove instructions or stores");
+    }
 }
 
