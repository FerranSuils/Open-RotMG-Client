+use super::*;
+
+const RETURN: Op<'static> = Op::ReturnVoid { return_type: None };
+fn cleanup(ops: &[Op<'static>], targets: &[usize]) -> Vec<Op<'static>> {
+    let ops: Vec<_> = ops.iter().copied().map(Cell::new).collect();
+    cleanup_unused_locals(&ops, &targets.iter().copied().collect());
+    ops.iter()
+        .map(Cell::get)
+        .filter(|op| !op.is_nop())
+        .collect()
+}
+
+#[test]
+fn dead_local_chains_reach_fixed_point() {
+    let mut ops = vec![Op::PushTrue, Op::SetLocal { index: 1 }];
+    for index in 1..80 {
+        ops.extend([Op::GetLocal { index }, Op::SetLocal { index: index + 1 }]);
+    }
+    ops.extend([Op::GetLocal { index: 80 }, Op::Pop, RETURN]);
+    assert!(matches!(
+        cleanup(&ops, &[]).as_slice(),
+        [Op::ReturnVoid { .. }]
+    ));
+}
+
+#[test]
+fn nested_pure_pushes_and_pops_reach_fixed_point() {
+    let mut ops = vec![Op::PushTrue; 80];
+    ops.extend([Op::Pop; 80]);
+    ops.push(RETURN);
+    assert!(matches!(
+        cleanup(&ops, &[]).as_slice(),
+        [Op::ReturnVoid { .. }]
+    ));
+}
+
+#[test]
+fn preserves_coercion_producers_receiver_and_branch_entries() {
+    let ops = [
+        Op::GetLocal { index: 1 },
+        Op::CoerceI,
+        Op::SetLocal { index: 2 },
+        Op::GetLocal { index: 2 },
+        Op::Pop,
+        RETURN,
+    ];
+    assert!(matches!(
+        cleanup(&ops, &[]).as_slice(),
+        [
+            Op::GetLocal { index: 1 },
+            Op::CoerceI,
+            Op::Pop,
+            Op::ReturnVoid { .. }
+        ]
+    ));
+    assert!(matches!(
+        cleanup(&[Op::PushNull, Op::SetLocal { index: 0 }, RETURN], &[]).as_slice(),
+        [
+            Op::PushNull,
+            Op::SetLocal { index: 0 },
+            Op::ReturnVoid { .. }
+        ]
+    ));
+    assert!(matches!(
+        cleanup(
+            &[
+                Op::GetLocal { index: 1 },
+                Op::GetSlot { index: 5 },
+                Op::ReturnValue { return_type: None }
+            ],
+            &[1]
+        )
+        .as_slice(),
+        [
+            Op::GetLocal { index: 1 },
+            Op::GetSlot { index: 5 },
+            Op::ReturnValue { .. }
+        ]
+    ));
