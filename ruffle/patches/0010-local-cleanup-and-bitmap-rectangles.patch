+fn bitmap_rectangle(commands: &[DrawCommand]) -> Option<[[f32; 2]; 4]> {
+    use DrawCommand::{LineTo, MoveTo};
+    // Drawing prepends its previous cursor; Lyon keeps only the last leading MoveTo.
+    let first_edge = commands.iter().position(|c| !matches!(c, MoveTo(_)))?;
+    let commands = &commands[first_edge.checked_sub(1)?..];
+    let corners = match commands {
+        [MoveTo(a), LineTo(b), LineTo(c), LineTo(d)] => [*a, *b, *c, *d],
+        [MoveTo(a), LineTo(b), LineTo(c), LineTo(d), LineTo(e)] if a == e => [*a, *b, *c, *d],
+        _ => return None,
+    };
+    let p = corners.map(|v| [v.x.to_pixels() as f32, v.y.to_pixels() as f32]);
+    (p[0][0] == p[3][0] && p[1][0] == p[2][0] && p[0][1] == p[1][1] && p[2][1] == p[3][1]
+        && p[1][0] - p[0][0] >= 0.5 && p[3][1] - p[0][1] >= 0.5
+        && p.iter().flatten().all(|v| v.is_finite() && v.abs() <= 32768.0)).then_some(p)
