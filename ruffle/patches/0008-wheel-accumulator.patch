+        let remainder = self.wheel_remainder.get();
+        let pixels = if pixels * remainder < 0.0 {
+            pixels
+        } else {
+            pixels + remainder
+        };
+        let lines = MouseWheelDelta::Pixels(pixels).lines().trunc();
+        self.wheel_remainder
+            .set(pixels - MouseWheelDelta::Lines(lines).pixels());
+        lines as i32
+    }
