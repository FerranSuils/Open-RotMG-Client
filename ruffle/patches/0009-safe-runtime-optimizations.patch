+use crate::avm2::op::Op;
+use std::cell::Cell;
+use std::collections::HashSet;
+
+pub fn eliminate_unused_locals(ops: &[Cell<Op<'_>>]) {
+    let mut read = HashSet::from([0]);
+    for op in ops {
+        match op.get() {
+            Op::GetLocal { index }
+            | Op::GetLocalSlot { local: index, .. }
+            | Op::IncLocal { index }
+            | Op::IncLocalI { index }
+            | Op::DecLocal { index }
+            | Op::DecLocalI { index } => {
+                read.insert(index);
+            }
+            Op::HasNext2 {
+                object_register,
+                index_register,
+            } => {
+                read.insert(object_register);
+                read.insert(index_register);
+            }
+            Op::Debug {
+                is_local_register: true,
+                register,
+                ..
+            } => {
+                read.insert(u32::from(register));
+            }
+            _ => {}
+        }
+    }
+    for op in ops {
+        match op.get() {
+            Op::SetLocal { index } if !read.contains(&index) => op.set(Op::Pop),
+            Op::StoreLocal { index } if !read.contains(&index) => op.set(Op::Nop),
+            _ => {}
+        }
+    }
+}
