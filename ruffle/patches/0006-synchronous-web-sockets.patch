+    #[test]
+    fn direct_output_flushes_before_an_executor_turn_and_channel_output_stays_fifo() {
+        let (tx, rx) = async_channel::unbounded();
+        let bytes = std::rc::Rc::new(std::cell::RefCell::new(vec![]));
+        let captured = bytes.clone();
+        let mut direct = SocketOutput::Direct(Box::new(move |data| {
+            captured.borrow_mut().push(data);
+            Ok(())
+        }));
+        direct.send(&tx, vec![1, 2]).unwrap();
+        assert_eq!(*bytes.borrow(), vec![vec![1, 2]]);
+        assert!(rx.is_empty());
+        let mut channel = SocketOutput::Channel;
+        for n in 0..3 {
+            channel.send(&tx, vec![n]).unwrap();
+        }
+        for n in 0..3 {
+            assert_eq!(rx.try_recv().unwrap(), vec![n]);
+        }
+        drop(rx);
+        assert!(channel.send(&tx, vec![4]).is_err());
+        let mut failed = SocketOutput::Direct(Box::new(|_| Err("closed transport".into())));
+        assert_eq!(failed.send(&tx, vec![5]), Err("closed transport".into()));
+    }
 
